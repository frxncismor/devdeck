{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capabilities for the main window. No generic shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-path"
  ]
}
