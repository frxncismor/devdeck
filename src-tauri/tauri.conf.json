{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDeck",
  "version": "0.1.0",
  "identifier": "dev.devdeck.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DevDeck",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "shortDescription": "Developer dashboard: worktrees, ports, JSON viewer and reclaim.",
    "longDescription": "DevDeck tracks git worktrees, shows which worktree owns each listening port, browses multi-hundred-MB JSON files, and reclaims disk and RAM from forgotten worktrees, orphaned dev processes and regenerable build folders.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
